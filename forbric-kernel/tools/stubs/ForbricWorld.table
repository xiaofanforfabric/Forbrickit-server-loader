# One loaded world, as org.bukkit.World.
#
# Every method org.bukkit.World declares is generated. `@template` means the body is written in the template,
# next to the fields it reads — which is where the game's own types have to appear, so those methods cannot be
# one-liners in a table. Everything else refuses with a named exception.
#
# A method with overloads is named `name(arity)`; a bare `name` covers the no-argument form only.

interface: org.bukkit.World
class: ForbricWorld
package: org.cn.xiaofan.bukkit
file: src/runtime/java/org/cn/xiaofan/bukkit/ForbricWorld.java
template: ForbricWorld.java.in

[methods]
getName = @template
getUID = @template
getMinHeight = @template
getMaxHeight = @template
getSeaLevel = @template
getTime = @template
setTime(1) = @template
getFullTime = @template
setFullTime(1) = @template
isDayTime = @template
getDifficulty = @template
getSpawnLocation = @template
getBlockAt(3) = @template
getPlayers = @template
rayTraceBlocks(6) = @template
rayTraceEntities(5) = @template
rayTrace(8) = @template
playSound(Location,Sound,SoundCategory,float,float) = @template
playSound(Location,Sound,SoundCategory,float,float,long) = @template
playSound(Location,String,SoundCategory,float,float) = @template
playSound(Location,String,SoundCategory,float,float,long) = @template
playSound(Entity,Sound,SoundCategory,float,float) = @template
playSound(Entity,String,SoundCategory,float,float) = @template
playSound(Entity,Sound,SoundCategory,float,float,long) = @template
playSound(Entity,String,SoundCategory,float,float,long) = @template
spawnParticle(13) = @template
createExplosion(double,double,double,float,boolean,boolean,Entity) = @template
createExplosion(Entity,Location,float,boolean,boolean,boolean) = @template
createExplosion(Location,float,boolean,boolean,Entity) = @template
strikeLightning(1) = @template
strikeLightningEffect(1) = @template
getNearbyEntities(5) = @template
getNearbyEntities(2) = @template
